    <single_statement>N</single_statement>
    <sql>ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DTEMISSAOIDENT VARCHAR(100) NULL
;
ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DTTITELEITOR VARCHAR(100) NULL
;
ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DTCARTTRAB VARCHAR(100) NULL
;
ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DTVENCHABILIT VARCHAR(100) NULL
;
ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DTEMISSPASSAPORTE VARCHAR(100) NULL
;
ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DTVALPASSAPORTE VARCHAR(100) NULL
;
ALTER TABLE [dbo].ZMIGRA_PPESSOA ALTER COLUMN DATAOBITO VARCHAR(100) NULL
;
UPDATE ZMIGRA_PPESSOA SET DTNASCIMENTO = '1931-12-31' WHERE DTNASCIMENTO = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DTEMISSAOIDENT = NULL WHERE DTEMISSAOIDENT = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DTTITELEITOR = NULL WHERE DTTITELEITOR = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DTCARTTRAB = NULL WHERE DTCARTTRAB = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DTVENCHABILIT = NULL WHERE DTVENCHABILIT = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DTEMISSPASSAPORTE = NULL WHERE DTEMISSPASSAPORTE = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DTVALPASSAPORTE = NULL WHERE DTVALPASSAPORTE = '1900-01-01'
;
UPDATE ZMIGRA_PPESSOA SET DATAOBITO = NULL WHERE DATAOBITO = '1900-01-01'
;</sql>
